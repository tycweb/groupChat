<?xml version="1.0" encoding="utf-8"?>
<!-- Sent bubble followed by another from the same sender: bottom-right tail
     flattens to full 18dp (matches web .msg-row.me.grouped-next .msg-bubble). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:type="linear" android:angle="315" android:startColor="@color/accent1" android:endColor="@color/accent2" />
    <corners
        android:topLeftRadius="18dp"
        android:topRightRadius="18dp"
        android:bottomLeftRadius="18dp"
        android:bottomRightRadius="18dp" />
</shape>
