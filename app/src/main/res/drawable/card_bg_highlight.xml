<?xml version="1.0" encoding="utf-8"?>
<!-- Same shape as card_bg, but with an accent-tinted fill and a glowing
     accent-colored border so a conversation that just got a new message
     (and jumped to the top of the list) is obviously different from the
     rest of the list until the user opens it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#2a1f18" />
    <stroke android:width="1.5dp" android:color="@color/accent1" />
    <corners android:radius="18dp" />
</shape>
