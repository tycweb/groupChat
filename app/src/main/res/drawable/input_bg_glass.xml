<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the web app's .message-input: solid black2, thin @color/line
     border, no translucency/glass. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/black2" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="100dp" />
            <padding
                android:left="18dp"
                android:top="12dp"
                android:right="18dp"
                android:bottom="12dp" />
        </shape>
    </item>
</layer-list>
