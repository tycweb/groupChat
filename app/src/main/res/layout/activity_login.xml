<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/black0"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tycept"
        android:textColor="@color/accent1"
        android:textSize="34sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter a name and password to join."
        android:textColor="@color/gray1"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:id="@+id/formFields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your name"
            android:textColorHint="@color/gray2"
            android:textColor="@color/white"
            android:background="@drawable/input_bg"
            android:maxLines="1"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:inputType="textPassword"
            android:textColorHint="@color/gray2"
            android:textColor="@color/white"
            android:background="@drawable/input_bg"
            android:maxLines="1"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <CheckBox
                android:id="@+id/rememberMeCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remember me on this device"
                android:textColor="@color/gray1"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="First time with this name? That password is now yours — enter the same one next time to log back in as you."
            android:textColor="@color/gray2"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/joinButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Join chat"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/gradient_button"
            android:padding="14dp" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#f87171"
            android:textSize="13sp"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/skeletonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/skeleton_bar"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/skeleton_bar"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="140dp"
            android:layout_height="18dp"
            android:background="@drawable/skeleton_bar"
            android:layout_marginBottom="20dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/skeleton_bar" />

        <TextView
            android:id="@+id/skeletonLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connecting…"
            android:textColor="@color/gray1"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</LinearLayout>
