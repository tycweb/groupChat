<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/messageRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@drawable/bubble_received"
        android:clipToOutline="true"
        android:elevation="1dp"
        android:layout_marginEnd="60dp">

        <TextView
            android:id="@+id/messageSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent2"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingTop="10dp" />

        <!-- Sized to the actual photo's aspect ratio (adjustViewBounds) instead
             of a fixed square, so there's no cropping and no leftover black
             space below the image. Timestamp is overlaid directly on the
             photo, bottom-end corner, matching the web app. -->
        <FrameLayout
            android:id="@+id/messageImageWrap"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <ImageView
                android:id="@+id/messageImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:maxHeight="320dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:background="@color/black3" />

            <FrameLayout
                android:id="@+id/imageSaveButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/save_button_bg">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_download" />

            </FrameLayout>

            <TextView
                android:id="@+id/imageTimeOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:background="@drawable/media_time_chip"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/white"
                android:textSize="11sp" />

        </FrameLayout>

        <!-- Same idea for video: the thumbnail's real aspect ratio drives the
             bubble's size (see ChatMessageAdapter for how the player is
             kept the same height once playback starts). -->
        <FrameLayout
            android:id="@+id/messageVideoContainer"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <ImageView
                android:id="@+id/messageVideoThumb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="150dp"
                android:maxHeight="320dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:background="@color/black3" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/messageVideoPlayer"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:visibility="gone"
                app:resize_mode="fit"
                app:use_controller="false"
                app:show_buffering="never" />

            <FrameLayout
                android:id="@+id/playButtonOverlay"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/play_button_bg">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_play" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/videoSaveButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/save_button_bg">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_download" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/videoExpandButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/save_button_bg">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_expand" />

            </FrameLayout>

            <TextView
                android:id="@+id/videoTimeOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:background="@drawable/media_time_chip"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/white"
                android:textSize="11sp" />

        </FrameLayout>

        <!-- Only present at all when the message actually has text — a pure
             photo/video message relies on the overlay timestamp above instead,
             so there's no empty extra row under the media. -->
        <LinearLayout
            android:id="@+id/messageTextWrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/messageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/messageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:textColor="@color/gray1"
                android:textSize="11sp"
                android:paddingTop="3dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
