<?xml version="1.0" encoding="utf-8"?>
<!-- Plays once, right when a conversation gets bumped to position 0 because
     a new message came in. A quick scale "pop" so the eye catches the item
     landing at the top of the list, then it settles at normal size (the
     persistent highlight border/dot from card_bg_highlight + unread_dot
     stays until the user opens the chat). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/overshoot_interpolator">
    <scale
        android:fromXScale="0.94"
        android:toXScale="1.0"
        android:fromYScale="0.94"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="320"
        android:fillAfter="true" />
    <alpha
        android:fromAlpha="0.4"
        android:toAlpha="1.0"
        android:duration="320" />
</set>
